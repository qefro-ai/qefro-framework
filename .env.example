DATABASE_URL=postgres://qefro:qefro@127.0.0.1:5432/qefro
JWT_SECRET=dev-only-change-me
QEFRO_BIND=0.0.0.0:8080
QEFRO_BIND_ADDRESS=0.0.0.0:8080
QEFRO_ENV=development
QEFRO_PUBLIC_URL=http://127.0.0.1:8080
QEFRO_LOG_LEVEL=info
QEFRO_STORAGE_PATH=./var/qefro-storage
# Production: leave unset or false so the process does not alter schema on boot.
# Apply schema with `qefro migrate` (or the migrate container command) first.
QEFRO_AUTO_MIGRATE=true
# Production compose runs `qefro worker` as a separate process.
QEFRO_EMBED_WORKER=true
# Production: leave unset/false. Development defaults to true.
# QEFRO_ALLOW_REGISTER=true
# Comma-separated browser origins. Production rejects '*'.
# QEFRO_CORS_ORIGINS=https://app.example.com
# Access token lifetime in hours (default 12). Browser UI refreshes before expiry.
# QEFRO_TOKEN_TTL_HOURS=12
RUST_LOG=info,sqlx=warn,tower_http=info
